// A fragment for ~/.config/omarchy/extensions/omarchy-menu.jsonc, not a full
// file. Install it with tools/install-menu-entries.sh, which splices this key
// into your own extension file. Adds Style > Lock Studio, which opens the
// Lock Studio picker. The key and aliases match earlier lock screen picker
// rows, so an existing row is swapped rather than doubled.
  "style.lockscreen": {"icon":"󰌾","label":"Lock Studio","aliases":["lockscreen","lock-screen","lock-designs","lock-studio"],"description":"Pick a lock screen design and personal settings","action":"omarchy-shell lock explore"},
